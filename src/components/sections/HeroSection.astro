---
import MestLogo from '@/components/brand/MestLogo.astro';
import { PipeCleanerArt } from '@/components/art/PipeCleanerArt';
import { OriginalPosterModal } from '@/components/lightbox/OriginalPosterModal';

const titleText = "Mestiere fiolet";
---

<section id="hero" class="relative min-h-[92vh] flex flex-col items-center justify-center pt-24 pb-16 px-4 sm:px-6 overflow-hidden text-center">
  {/* Floating Frameless Pipe Cleaner Elements with Parallax Depth */}
  <div class="pointer-events-none absolute inset-0 overflow-hidden select-none" aria-hidden="true">
    {/* Floating Left: Lily & Coquette Bow */}
    <div class="hero-float-left-1 absolute -left-10 sm:left-6 md:left-12 lg:left-20 top-24 sm:top-20 opacity-80 transition-transform duration-1000 animate-float">
      <PipeCleanerArt id="bunga-lily" size={140} className="w-24 sm:w-32 lg:w-40 -rotate-12" client:load />
    </div>
    <div class="hero-float-left-2 absolute left-2 sm:left-16 md:left-28 lg:left-36 bottom-20 sm:bottom-28 opacity-85 transition-transform duration-1000 animate-float" style="animation-delay: 1.5s;">
      <PipeCleanerArt id="gantungan-coquette" size={130} className="w-20 sm:w-28 lg:w-32 rotate-6" client:load />
    </div>

    {/* Floating Right: Royal Blue Tulip & Sunflower */}
    <div class="hero-float-right-1 absolute -right-8 sm:right-6 md:right-12 lg:right-20 top-28 sm:top-24 opacity-85 transition-transform duration-1000 animate-float" style="animation-delay: 0.8s;">
      <PipeCleanerArt id="bunga-tulip" size={140} className="w-24 sm:w-32 lg:w-40 rotate-12" client:load />
    </div>
    <div class="hero-float-right-2 absolute right-2 sm:right-16 md:right-28 lg:right-36 bottom-24 sm:bottom-32 opacity-80 transition-transform duration-1000 animate-float" style="animation-delay: 2.2s;">
      <PipeCleanerArt id="bunga-sunflower" size={135} className="w-20 sm:w-28 lg:w-36 -rotate-6" client:load />
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-4xl flex flex-col items-center">
    {/* Top Brand Tag */}
    <div class="hero-tag mb-5 inline-flex items-center gap-2 rounded-full bg-white/70 px-4 py-1.5 text-xs font-semibold text-[#7B1FA2] shadow-sm backdrop-blur-md border border-[#E5D0F6]">
      <span class="inline-block h-2 w-2 rounded-full bg-[#1C9C3E] animate-pulse"></span>
      <span class="tracking-wide uppercase">📍 JATINANGOR • OPEN ORDER SETIAP HARI</span>
    </div>

    {/* Center Round Emblem Logo */}
    <div class="hero-logo mb-6">
      <MestLogo size="md" showCircle={true} />
    </div>

    {/* Staggered Letter-by-Letter Animated Headline */}
    <h1 class="hero-title font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight text-[#7B1FA2] leading-[1.05]">
      {titleText.split("").map((char) => (
        <span class="hero-char inline-block opacity-0" data-char={char}>
          {char === " " ? "\u00A0" : char}
        </span>
      ))}
      <span class="hero-char inline-block opacity-0 ml-2 text-4xl sm:text-5xl md:text-6xl">🎀🌷</span>
    </h1>

    {/* Editorial Subtitle with Italian & Gen-Z Aesthetic */}
    <p class="hero-subtitle mt-5 font-serif italic text-xl sm:text-2xl md:text-3xl text-[#F27EB2] max-w-2xl font-normal leading-relaxed">
      Make Your Own Desain : Free Custom Buket & Gantungan Gemas Mulai dari 1K - 10K Aja!
    </p>

    {/* Narrative Body Text */}
    <p class="hero-body mt-4 max-w-xl text-sm sm:text-base text-[#3B2342]/85 leading-relaxed">
      Lagi cari buket sempro, wisuda, atau Idol Bucket buat bestie di Jatinangor? Atau pengen gantungan jellyfish & coquette ribbon buat nemenin tas kuliah? Bebas request warna dan rangkai tangkai bungamu sendiri sesuai budget!
    </p>

    {/* Action Triggers & Original Poster Lightbox */}
    <div class="hero-actions mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#custom-builder"
        class="inline-flex items-center gap-2 rounded-full bg-[#7B1FA2] px-7 py-3 text-sm font-semibold text-white shadow-md hover:bg-[#6A1B9A] hover:shadow-lg transition-all hover:scale-105 focus:outline-none focus:ring-2 focus:ring-[#7B1FA2]"
      >
        <span>Mulai Rangkai Buketmu (Mulai 10K)</span>
        <span class="text-base">↗</span>
      </a>

      <a
        href="#pricelist-bunga"
        class="inline-flex items-center gap-2 rounded-full bg-white/80 px-6 py-3 text-sm font-semibold text-[#7B1FA2] shadow-sm backdrop-blur-md hover:bg-white hover:shadow-md transition-all border border-[#E5D0F6] focus:outline-none focus:ring-2 focus:ring-[#7B1FA2]"
      >
        <span>Lihat Price List Lengkap</span>
        <span class="text-base">↓</span>
      </a>

      <OriginalPosterModal client:load />
    </div>

    {/* Quick Price Anchors */}
    <div class="hero-anchors mt-10 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs sm:text-sm text-[#3B2342]/80">
      <div class="flex items-center gap-1.5 font-medium">
        <span class="text-[#F27EB2]">✦</span>
        <span>Bucket : Mulai 10K - 25K</span>
      </div>
      <div class="flex items-center gap-1.5 font-medium">
        <span class="text-[#F27EB2]">✦</span>
        <span>Bunga Satuan : 1K - 8K</span>
      </div>
      <div class="flex items-center gap-1.5 font-medium">
        <span class="text-[#F27EB2]">✦</span>
        <span>Gantungan : 3K - 8K</span>
      </div>
      <div class="flex items-center gap-1.5 font-medium">
        <span class="text-[#F27EB2]">✦</span>
        <span>Free Custom Desain</span>
      </div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    :global(.hero-char),
    :global(.hero-subtitle),
    :global(.hero-body),
    :global(.hero-actions) {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
