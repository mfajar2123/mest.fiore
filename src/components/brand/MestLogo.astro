---
import { withBase } from '@/lib/paths';

interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showCircle?: boolean;
  className?: string;
  alt?: string;
}

const {
  size = 'md',
  className = '',
  alt = 'Logo Mestiere Fiolet @mest.fiore Jatinangor',
} = Astro.props;

const sizeStyles = {
  sm: 'w-10 h-10',
  md: 'w-20 h-20',
  lg: 'w-28 h-28',
  xl: 'w-36 h-36',
}[size];

const pixelDimensions = {
  sm: 44,
  md: 80,
  lg: 112,
  xl: 144,
}[size];
---

<div class={`mest-logo-container relative inline-flex items-center justify-center shrink-0 ${sizeStyles} ${className}`}>
  <div class="relative w-full h-full rounded-full overflow-hidden border border-[#E5DAEC] bg-white ring-2 ring-[#FAD9EC]/80 shadow-sm transition-transform duration-300 hover:scale-105 flex items-center justify-center">
    <img
      src={withBase('/images/logo.jpg')}
      alt={alt}
      width={pixelDimensions}
      height={pixelDimensions}
      loading="eager"
      decoding="async"
      class="w-full h-full object-cover select-none"
    />
  </div>
</div>
